<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FeiSharpTerminal3._1</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>feisharp</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>preview</LangVersion>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>

  <!-- WinForms is used by FeiSharp.UI; avoid importing it globally because the
       console host intentionally uses Spectre.Console's Color and Panel. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="BaseKeyword\BaseKeyword.csproj" Condition="Exists('BaseKeyword\BaseKeyword.csproj')" />
    <Reference Include="BaseKeyword" Condition="!Exists('BaseKeyword\BaseKeyword.csproj') And Exists('bin\Debug\net8.0-windows\BaseKeyword.dll')">
      <HintPath>bin\Debug\net8.0-windows\BaseKeyword.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="VerificationHarness\**\*.cs" />
    <Compile Remove="BaseKeyword\**\*.cs" />
    <Compile Remove="MyPlugin\**\*.cs" />
    <Compile Remove="FeiFormStudio\**\*.cs" />
    <EmbeddedResource Remove="VerificationHarness\**\*" />
    <None Remove="VerificationHarness\**\*" />
    <None Remove="FeiFormStudio\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.54" />
    <PackageReference Include="Jint" Version="3.1.2" />
    <PackageReference Include="Microsoft.Playwright" Version="1.52.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="PublishAotCompressed" Version="1.0.5" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
    <PackageReference Include="System.Management" Version="9.0.5" />
    <PackageReference Include="System.Speech" Version="9.0.4" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
